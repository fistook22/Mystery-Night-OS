# Copy to .env and fill in. Everything is optional in development.

PORT=3000
# Base URL that invite links point to (the web app). In dev this is the Vite server.
PUBLIC_URL=http://localhost:5173
DATABASE_PATH=data/mystery-night.db

# Claude: AI characters and the game master. Without a key, characters use scripted fallback replies.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# NLPearl: voice calls (phase 5). Without a key, calls are shown as chat.
NLPEARL_API_KEY=
