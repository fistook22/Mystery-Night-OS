# ── Server ────────────────────────────────────────────────────
PORT=3000

# ── Anthropic (Claude) ────────────────────────────────────────
# Required for AI-personalized onboarding messages and wildcard events
# Get your key: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── WhatsApp Cloud API ────────────────────────────────────────
# Meta Business account required: https://developers.facebook.com/docs/whatsapp
WHATSAPP_TOKEN=           # Permanent token from Meta System User
WHATSAPP_PHONE_ID=        # Phone Number ID from WhatsApp Business
WHATSAPP_VERIFY_TOKEN=    # Any secret string — used to verify webhook URL

# ── Twilio (AI Voice Calls) ───────────────────────────────────
# Required for the Live AI tier (voice calls to guests)
# Get credentials: https://console.twilio.com
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...  # Twilio purchased number

# ── Notes ─────────────────────────────────────────────────────
# If WhatsApp credentials are missing, WhatsApp messages are logged to console (mock mode)
# If Twilio credentials are missing, calls are logged to console (mock mode)
# If Anthropic key is missing, fallback templates are used for AI content
